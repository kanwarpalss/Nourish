{
  "name": "nourish",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/require-nourish-port.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 4317 --hostname 0.0.0.0",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node scripts/require-nourish-port.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --port 4317 --hostname 0.0.0.0",
    "health": "curl -fsS --connect-timeout 3 http://127.0.0.1:4317/ >/dev/null && echo 'Nourish is available at http://localhost:4317'",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && node --import tsx --test tests/prototype-logic.test.ts tests/cardiq-food.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "import:cardiq": "node --import tsx scripts/import-cardiq-food.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
